<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>مركز كنيسة الأنبا أنطونيوس</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Amiri:wght@400;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<style>
  :root{
    --navy:#1e3a5f;
    --navy-deep:#16293f;
    --gold:#c9a24a;
    --gold-light:#e6cf94;
    --cream:#faf6ea;
    --cream-deep:#f1e9d2;
    --ink:#2a2a28;
    --muted:#7c7566;
    --white:#fffefb;
    --danger:#a5402f;
    --radius:14px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    font-family:'Cairo', 'Tahoma', sans-serif;
    background:var(--cream);
    color:var(--ink);
    min-height:100vh;
    position:relative;
  }
  /* subtle watermark background */
  .bg-watermark{
    position:fixed;
    inset:0;
    z-index:0;
    pointer-events:none;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
  }
  .bg-watermark img{
    width:min(70vw,640px);
    opacity:0.05;
    filter:grayscale(15%);
  }
  .app{
    position:relative;
    z-index:1;
    max-width:1100px;
    margin:0 auto;
    padding:0 18px 60px;
  }
  header.top{
    display:flex;
    flex-direction:column;
    align-items:center;
    text-align:center;
    padding:26px 10px 20px;
    gap:6px;
  }
  header.top .logo-badge{
    width:78px;height:78px;border-radius:50%;
    overflow:hidden;
    border:3px solid var(--gold);
    box-shadow:0 4px 14px rgba(30,58,95,0.18);
    background:var(--white);
    margin-bottom:6px;
  }
  header.top .logo-badge img{width:100%;height:100%;object-fit:cover;}
  header.top h1{
    margin:0;
    font-size:1.5rem;
    font-weight:800;
    color:var(--navy);
    letter-spacing:.5px;
  }
  header.top .sub{
    font-family:'Amiri', serif;
    color:var(--gold);
    font-size:1.05rem;
    font-weight:700;
  }
  header.top .tagline{
    color:var(--muted);
    font-size:.85rem;
    margin-top:2px;
  }
  .divider-orn{
    display:flex;align-items:center;gap:10px;
    color:var(--gold);
    margin:10px 0 4px;
    width:100%;
    max-width:260px;
  }
  .divider-orn::before,.divider-orn::after{
    content:"";flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--gold-light),transparent);
  }
  .divider-orn span{font-size:.9rem;}

  /* Home: grades grid */
  .section-title{
    font-size:1.05rem;
    font-weight:700;
    color:var(--navy);
    margin:22px 4px 12px;
    display:flex;
    align-items:center;
    gap:8px;
  }
  .section-title .count-pill{
    background:var(--cream-deep);
    color:var(--muted);
    font-size:.75rem;
    font-weight:600;
    padding:2px 10px;
    border-radius:20px;
  }
  .grades-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(150px,1fr));
    gap:12px;
  }
  .grade-card{
    background:var(--white);
    border:1px solid var(--cream-deep);
    border-radius:var(--radius);
    padding:16px 14px;
    cursor:pointer;
    transition:transform .15s ease, box-shadow .15s ease, border-color .15s;
    text-align:right;
    position:relative;
    overflow:hidden;
  }
  .grade-card:hover{
    transform:translateY(-3px);
    box-shadow:0 8px 20px rgba(30,58,95,0.12);
    border-color:var(--gold-light);
  }
  .grade-card .stage-tag{
    font-size:.68rem;
    color:var(--gold);
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.5px;
  }
  .grade-card h3{
    margin:6px 0 10px;
    font-size:1rem;
    color:var(--navy);
    font-weight:700;
  }
  .grade-card .num{
    font-size:1.6rem;
    font-weight:800;
    color:var(--navy);
  }
  .grade-card .num-label{
    font-size:.72rem;
    color:var(--muted);
  }
  .grade-card::after{
    content:"";
    position:absolute;
    inset-inline-start:0;
    top:0;bottom:0;
    width:4px;
    background:var(--gold);
    opacity:0;
    transition:opacity .15s;
  }
  .grade-card:hover::after{opacity:1;}

  /* Grade detail view */
  .back-btn{
    display:inline-flex;
    align-items:center;
    gap:6px;
    background:none;
    border:none;
    color:var(--navy);
    font-family:inherit;
    font-size:.92rem;
    font-weight:700;
    cursor:pointer;
    padding:14px 4px 0;
  }
  .grade-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
    gap:10px;
    margin:10px 4px 16px;
  }
  .grade-header h2{
    margin:0;
    color:var(--navy);
    font-size:1.3rem;
  }
  .grade-header .meta{
    color:var(--muted);
    font-size:.85rem;
  }
  .btn{
    font-family:inherit;
    border:none;
    border-radius:10px;
    padding:11px 18px;
    font-size:.9rem;
    font-weight:700;
    cursor:pointer;
    transition:filter .15s, transform .1s;
    display:inline-flex;
    align-items:center;
    gap:6px;
  }
  .btn:active{transform:scale(.97);}
  .btn-primary{background:var(--navy);color:var(--white);}
  .btn-primary:hover{filter:brightness(1.12);}
  .btn-gold{background:var(--gold);color:var(--navy-deep);}
  .btn-gold:hover{filter:brightness(1.08);}
  .btn-outline{background:transparent;border:1.5px solid var(--navy);color:var(--navy);}
  .btn-outline:hover{background:var(--navy);color:var(--white);}
  .btn-danger-text{background:none;color:var(--danger);padding:6px 8px;font-size:.82rem;}
  .btn-excel{background:#1e6b3f;color:var(--white);}
  .btn-excel:hover{filter:brightness(1.12);}
  .header-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;align-items:center;margin-top:12px;}
  .mode-pill{padding:5px 14px;border-radius:20px;font-size:.78rem;font-weight:700;}
  .mode-admin{background:#dff0e2;color:#1e6b3f;}
  .mode-view{background:var(--cream-deep);color:var(--muted);}
  .btn-sm{padding:7px 13px;font-size:.76rem;}
  #debug-box{
    max-width:520px;
    margin:14px auto 0;
    background:#fff2f0;
    border:1.5px solid var(--danger);
    color:#7a2a1e;
    border-radius:12px;
    padding:12px 14px;
    font-size:.78rem;
    text-align:right;
    direction:rtl;
    white-space:pre-wrap;
    word-break:break-word;
  }
  #debug-box .debug-title{
    font-weight:800;
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:6px;
  }
  #debug-box .debug-close{
    background:none;border:none;color:#7a2a1e;font-size:1rem;cursor:pointer;padding:2px 8px;
  }
  #debug-box code{
    display:block;
    background:#fff;
    border-radius:8px;
    padding:8px 10px;
    margin-top:4px;
    font-family:monospace;
    font-size:.74rem;
    direction:ltr;
    text-align:left;
  }

  .search-bar{
    width:100%;
    padding:11px 14px;
    border:1.5px solid var(--cream-deep);
    border-radius:10px;
    font-family:inherit;
    font-size:.92rem;
    background:var(--white);
    margin-bottom:14px;
  }
  .search-bar:focus{outline:none;border-color:var(--gold);}

  .student-list{
    display:flex;
    flex-direction:column;
    gap:10px;
  }
  .student-card{
    background:var(--white);
    border:1px solid var(--cream-deep);
    border-radius:var(--radius);
    padding:14px 16px;
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:10px;
    flex-wrap:wrap;
  }
  .student-card .s-name{
    font-weight:700;
    color:var(--navy);
    font-size:1rem;
  }
  .student-card .s-line{
    color:var(--muted);
    font-size:.82rem;
    margin-top:3px;
  }
  .teacher-chip{
    display:inline-block;
    background:var(--cream-deep);
    color:var(--navy);
    font-size:.75rem;
    font-weight:600;
    padding:3px 10px;
    border-radius:20px;
    margin:4px 4px 0 0;
  }
  .student-actions{
    display:flex;
    gap:4px;
  }
  .icon-btn{
    background:none;border:none;cursor:pointer;
    color:var(--muted);
    font-size:1rem;
    padding:6px;
    border-radius:8px;
  }
  .icon-btn:hover{background:var(--cream-deep);color:var(--navy);}
  .icon-btn.del:hover{color:var(--danger);}

  .empty-state{
    text-align:center;
    padding:50px 20px;
    color:var(--muted);
  }
  .empty-state .big{
    font-size:2.2rem;
    margin-bottom:8px;
  }

  /* Modal */
  .modal-overlay{
    position:fixed;inset:0;
    background:rgba(22,41,63,0.55);
    display:flex;
    align-items:flex-end;
    justify-content:center;
    z-index:50;
    animation:fadeIn .15s ease;
  }
  @keyframes fadeIn{from{opacity:0}to{opacity:1}}
  .modal{
    background:var(--cream);
    width:100%;
    max-width:520px;
    max-height:88vh;
    overflow-y:auto;
    border-radius:20px 20px 0 0;
    padding:22px 20px 26px;
    animation:slideUp .2s ease;
  }
  @media(min-width:600px){
    .modal-overlay{align-items:center;}
    .modal{border-radius:18px;}
  }
  @keyframes slideUp{from{transform:translateY(30px);opacity:0}to{transform:translateY(0);opacity:1}}
  .modal h2{
    margin:0 0 4px;
    color:var(--navy);
    font-size:1.2rem;
  }
  .modal .modal-sub{
    color:var(--muted);
    font-size:.82rem;
    margin-bottom:18px;
  }
  .field{margin-bottom:14px;}
  .field label{
    display:block;
    font-size:.85rem;
    font-weight:700;
    color:var(--navy);
    margin-bottom:6px;
  }
  .field .optional-tag{
    color:var(--muted);
    font-weight:400;
    font-size:.75rem;
  }
  .field input, .field select{
    width:100%;
    padding:11px 13px;
    border:1.5px solid var(--cream-deep);
    border-radius:10px;
    font-family:inherit;
    font-size:.92rem;
    background:var(--white);
    color:var(--ink);
  }
  .field input:focus, .field select:focus{outline:none;border-color:var(--gold);}
  .field .hint{font-size:.72rem;color:var(--muted);margin-top:4px;}

  .teachers-block{
    background:var(--white);
    border:1px dashed var(--cream-deep);
    border-radius:12px;
    padding:14px;
    margin-bottom:16px;
  }
  .teachers-block-title{
    display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;
  }
  .teachers-block-title span{font-weight:700;color:var(--navy);font-size:.9rem;}
  .teacher-row{
    display:flex;
    gap:8px;
    margin-bottom:8px;
    align-items:center;
  }
  .teacher-row input{
    flex:1;
    padding:9px 11px;
    border:1.5px solid var(--cream-deep);
    border-radius:8px;
    font-family:inherit;
    font-size:.86rem;
  }
  .teacher-row input:focus{outline:none;border-color:var(--gold);}
  .teacher-row button{
    background:var(--cream-deep);
    border:none;
    color:var(--danger);
    width:32px;height:32px;
    border-radius:8px;
    cursor:pointer;
    font-size:1rem;
    flex-shrink:0;
  }
  .add-teacher-btn{
    background:none;
    border:1.5px dashed var(--gold);
    color:var(--navy);
    width:100%;
    padding:9px;
    border-radius:8px;
    font-family:inherit;
    font-weight:700;
    font-size:.84rem;
    cursor:pointer;
  }
  .add-teacher-btn:hover{background:var(--gold-light);}
  .modal-buttons{
    display:flex;
    gap:10px;
    margin-top:6px;
  }
  .modal-buttons .btn{flex:1;justify-content:center;}
  .err-msg{
    color:var(--danger);
    font-size:.8rem;
    margin-top:4px;
  }
  .toast{
    position:fixed;
    bottom:24px;
    left:50%;
    transform:translateX(-50%);
    background:var(--navy);
    color:var(--white);
    padding:12px 22px;
    border-radius:30px;
    font-size:.86rem;
    font-weight:600;
    z-index:100;
    box-shadow:0 6px 20px rgba(0,0,0,.2);
    animation:fadeIn .2s ease;
  }
  ::selection{background:var(--gold-light);}
  @media(max-width:420px){
    header.top h1{font-size:1.25rem;}
    .grades-grid{grid-template-columns:repeat(auto-fill,minmax(130px,1fr));}
  }
</style>
</head>
<body>

<div class="bg-watermark"><img src="data:image/png;base64,